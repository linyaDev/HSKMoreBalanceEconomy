<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Карбоновый композит (CarbonAlloy) как материал инструментов.
	     Патч SurvivalToolsLite даёт ему лучшие в паке множители (1.3-1.4 на
	     рубку, сбор, шахту и стройку) — при том что сам композит гонится из
	     нефти почти даром. Обнуляем до 1.0: инструменты из него делать можно,
	     но бонусов к скорости и выходу больше нет. -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Survival Tools Lite</li>
		</mods>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="CarbonAlloy"]/modExtensions/li[@Class="SurvivalToolsLite.StuffPropsTool"]/toolStatFactors</xpath>
			<value>
				<toolStatFactors>
					<TreeFellingSpeed>1</TreeFellingSpeed>
					<PlantHarvestingSpeed>1</PlantHarvestingSpeed>
					<PlantWorkSpeed>1</PlantWorkSpeed>
					<MiningSpeed>1</MiningSpeed>
					<MiningYieldDigging>1</MiningYieldDigging>
					<ConstructionSpeed>1</ConstructionSpeed>
				</toolStatFactors>
			</value>
		</match>
	</Operation>
</Patch>
