<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Добывающая установка (Extractor): радиус добычи на клетку больше
	     буровой после нашего буста (DeepDrillRadius, 37 клеток ~3.2) —
	     61 ближайшая клетка (~4.2) вместо паковых 9 (~1.4).
	     Улучшенную (RareExtractor, 16 клеток) не трогаем.
	     Кольцо радиуса добавляем для наглядности — в паке его не было. -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Extractor"]/modExtensions/li[@Class="SK.MineExtractorExtension"]/MineSizeinCells</xpath>
		<value><MineSizeinCells>61</MineSizeinCells></value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Extractor"]</xpath>
		<value><specialDisplayRadius>4.6</specialDisplayRadius></value>
	</Operation>

	<!-- Сетка рудных залежей у ВЫБРАННОГО добытчика — как у буровой и сканера.
	     PlaceWorker_DeepDrill (рисует залежи) у обоих уже есть, не хватало
	     только флага «рисовать плейс-воркеры и у выбранной постройки». -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Extractor"]</xpath>
		<value><drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RareExtractor"]</xpath>
		<value><drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected></value>
	</Operation>
</Patch>
