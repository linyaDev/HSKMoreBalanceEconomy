		<xpath>Defs/RecipeDef[defName="MakeAmmo_50BMG_FMJ"]/products/Ammo_50BMG_FMJ</xpath>
		<value><Ammo_50BMG_FMJ>120</Ammo_50BMG_FMJ></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/RecipeDef[defName="MakeAmmo_50BMG_Incendiary"]/products/Ammo_50BMG_Incendiary</xpath>
		<value><Ammo_50BMG_Incendiary>120</Ammo_50BMG_Incendiary></value>
