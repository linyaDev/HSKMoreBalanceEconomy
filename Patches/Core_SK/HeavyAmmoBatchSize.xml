<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!--
		Крупный калибр: партия больше при том же расходе материалов.

		Эти боеприпасы проходят порог множителя крафта (AmmoCraftNerf множит
		ингредиенты у рецептов с партией от 20 штук), но расход слитков, свинца
		и пороха у них огромный, а у тяжёлых калибров ещё и гильза за 170. На
		выходе выстрел стоил в 4-6 раз дороже рыночной цены против 2.7-4.2 у
		стрелковки.

		Увеличение выхода возвращает их в коридор дешёвых патронов (x1.6-3.2),
		не трогая ни рецепты, ни множитель. Работа за партию не меняется — это
		компенсация за объём.

		Было -> стало (на партию):
		  7.62x51     60 -> 120    10.3 -> 5.2 серебра за патрон
		  .50 BMG     60 -> 120    15.1 -> 7.5
		  14.5x114    60 -> 180    25.3 -> 8.4
		  20x102      40 -> 180    38.6 -> 8.6
		  30x173      30 -> 150    53.6 -> 10.7
		  40x46       20 -> 40     68.1 -> 34.1
	-->

	<!-- 7.62x51 мм НАТО: 60 -> 120. Дорогая снайперская гильза (80) на партию
	     всего в 60 штук делала его дороже 12 калибра. -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/RecipeDef[defName="MakeAmmo_762x51mmNATO_FMJ"]/products/Ammo_762x51mmNATO_FMJ</xpath>
		<value><Ammo_762x51mmNATO_FMJ>120</Ammo_762x51mmNATO_FMJ></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/RecipeDef[defName="MakeAmmo_762x51mmNATO_AP"]/products/Ammo_762x51mmNATO_AP</xpath>
		<value><Ammo_762x51mmNATO_AP>120</Ammo_762x51mmNATO_AP></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/RecipeDef[defName="MakeAmmo_762x51mmNATO_HP"]/products/Ammo_762x51mmNATO_HP</xpath>
		<value><Ammo_762x51mmNATO_HP>120</Ammo_762x51mmNATO_HP></value>
	</Operation>

	<!-- .50 BMG: 60 -> 120 -->
